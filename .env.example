# Copy this file to .env.local and fill in your real values.
# .env.local is ignored by git and should never be committed.

# Supabase (required for auth and database)
VITE_SUPABASE_URL=https://rwvdvobopcfzalfausxg.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_2r7mA2JMpKGMSPnt9uMZpw_fT8UtEMb

# Stripe (required for checkout)
VITE_STRIPE_PUBLISHABLE_KEY=pk_live_your_key_here

# EmailJS (used by the frontend for event ticket / download emails)
# NOTE: EmailJS private keys should ideally live server-side. These are exposed to the browser.
VITE_EMAILJS_SERVICE_ID=your_service_id
VITE_EMAILJS_TEMPLATE_ID=your_template_id
VITE_EMAILJS_PUBLIC_KEY=your_public_key
VITE_EMAILJS_PRIVATE_KEY=your_private_key

# Resend (alternative email service — currently unused)
VITE_RESEND_API_KEY=re_your_key_here

# Kit (ConvertKit) newsletter
VITE_KIT_API_KEY=your_kit_api_key
VITE_KIT_FORM_ID=your_kit_form_id

# ------------------------------------------------------------------
# Supabase Edge Function secrets (set in the Supabase dashboard, not here)
